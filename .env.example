# Copia este archivo a .env y cambia los valores. El archivo .env NO se sube a Git.

# Base de datos (la usa docker-compose.yml)
POSTGRES_USER=retrogamelog
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=retrogamelog

# Usuario de desarrollo, solo en tu máquina (python -m app.dev_user; ver backend/README.md).
